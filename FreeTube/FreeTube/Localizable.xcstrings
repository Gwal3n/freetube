    "Playback does not use yt-dlp. Downloads may fall back to it; FreeTube checks for updates about once a week." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe nutzt yt-dlp nicht. Downloads können darauf zurückgreifen; FreeTube prüft etwa einmal pro Woche auf Updates."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback does not use yt-dlp. Downloads may fall back to it; FreeTube checks for updates about once a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción no usa yt-dlp. Las descargas pueden recurrir a él; FreeTube busca actualizaciones aproximadamente una vez por semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture n’utilise pas yt-dlp. Les téléchargements peuvent y recourir ; FreeTube vérifie les mises à jour environ une fois par semaine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизведение не использует yt-dlp. Загрузки могут применять его как запасной вариант; FreeTube проверяет обновления примерно раз в неделю."
