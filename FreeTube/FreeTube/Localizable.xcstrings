        }
      }
    },
    "This permanently removes the selected file%@ from your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die ausgewählte Datei%@ endgültig von deinem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently removes the selected file%@ from your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente el archivo seleccionado%@ de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement le fichier sélectionné%@ de votre appareil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это окончательно удалит выбранный файл%@ с устройства."
          }
        }
      }
    },
    "This removes every file under Documents/Logs/. If \"Save logs to file\" is on, a fresh log file will be opened for new entries." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Dateien unter Documents/Logs/ entfernt. Wenn „Logs in Datei speichern“ aktiviert ist, wird eine neue Logdatei für neue Einträge geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every file under Documents/Logs/. If \"Save logs to file\" is on, a fresh log file will be opened for new entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los archivos en Documents/Logs/. Si «Guardar registros en archivo» está activado, se abrirá un nuevo archivo de registro para las nuevas entradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci supprime tous les fichiers dans Documents/Logs/. Si « Enregistrer les journaux dans un fichier » est activé, un nouveau fichier journal sera ouvert pour les nouvelles entrées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все файлы в Documents/Logs/. Если включён параметр «Сохранять логи в файл», для новых записей будет создан новый файл лога."
          }
        }
      }
    },
    "This removes the playlist and its saved entries." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Playlist und ihre gespeicherten Einträge entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the playlist and its saved entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la lista y sus entradas guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime la playlist et ses entrées enregistrées."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет плейлист и сохранённые записи."
          }
        }
      }
    },
    "This removes the selected playlists and their saved entries." : {
      "localizations" : {
