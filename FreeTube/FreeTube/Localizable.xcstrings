    "Quality" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualität"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quality"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualité"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качество"
          }
        }
      }
    },
    "Quality is a maximum for adaptive streams, not a guaranteed resolution. Prefetching loads details and the first comments page after playback starts. Allowing other audio may leave another app in control of Lock Screen playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Qualität ist bei adaptiven Streams eine Obergrenze, keine garantierte Auflösung. Das Vorladen lädt nach Wiedergabestart Details und die erste Kommentarseite. Wenn Audio anderer Apps erlaubt ist, kann eine andere App die Sperrbildschirm-Steuerung behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quality is a maximum for adaptive streams, not a guaranteed resolution. Prefetching loads details and the first comments page after playback starts. Allowing other audio may leave another app in control of Lock Screen playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calidad es un máximo para los flujos adaptativos, no una resolución garantizada. La precarga obtiene los detalles y la primera página de comentarios después de iniciar la reproducción. Al permitir el audio de otras apps, otra app puede conservar los controles de la pantalla de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualité est un plafond pour les flux adaptatifs, pas une résolution garantie. Le préchargement récupère les détails et la première page de commentaires après le début de la lecture. Si l’audio d’autres apps est autorisé, une autre app peut conserver les commandes de l’écran verrouillé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качество задаёт верхний предел для адаптивных потоков, но не гарантирует разрешение. Предзагрузка получает сведения и первую страницу комментариев после начала воспроизведения. Если разрешён звук других приложений, управление на экране блокировки может остаться у другого приложения."
          }
        }
      }
    },
