            "value" : "Интерфейс плеера следует выбранной теме; область видео остаётся чёрной."
          }
        }
      }
    },
    "The Videos tab is always first. Tabs unavailable on a channel stay hidden regardless of these settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos bleibt immer der erste Tab. Tabs, die für einen Kanal nicht verfügbar sind, bleiben unabhängig von diesen Einstellungen ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Videos tab is always first. Tabs unavailable on a channel stay hidden regardless of these settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos siempre será la primera pestaña. Las pestañas no disponibles en un canal permanecerán ocultas independientemente de estos ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéos reste toujours le premier onglet. Les onglets indisponibles sur une chaîne restent masqués, quels que soient ces réglages."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео всегда остаётся первой вкладкой. Недоступные для канала вкладки будут скрыты независимо от этих настроек."
          }
        }
      }
    },
