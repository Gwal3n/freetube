    "Your YouTube channel ID wasn't returned in the library response. Try refreshing the Library screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine YouTube-Kanal-ID wurde in der Mediathek-Antwort nicht zurückgegeben. Versuche, den Mediathek-Bildschirm zu aktualisieren."
