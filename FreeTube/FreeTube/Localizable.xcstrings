    "Swipe left to remove a duration. At least one remains available. You can also enter a custom duration in the player." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entfernen einer Dauer nach links wischen. Mindestens eine bleibt verfügbar. Im Player kannst du auch eine eigene Dauer eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left to remove a duration. At least one remains available. You can also enter a custom duration in the player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para quitar una duración. Debe quedar al menos una. También puedes introducir una duración personalizada en el reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour supprimer une durée. Au moins une doit rester disponible. Vous pouvez aussi saisir une durée personnalisée dans le lecteur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните влево, чтобы удалить длительность. Должна остаться хотя бы одна. В плеере также можно указать свою длительность."
          }
        }
      }
