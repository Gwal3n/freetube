            "value" : "Die Player-Oberfläche folgt der Darstellung; die Videofläche bleibt schwarz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player interface follows your appearance; the video canvas stays black."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La interfaz del reproductor sigue la apariencia elegida; el área de vídeo permanece negra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’interface du lecteur suit l’apparence choisie ; la surface vidéo reste noire."
