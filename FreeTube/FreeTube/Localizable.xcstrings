    "Drag the handles to reorder tabs. Search keeps its native system position. Settings remains available when Library is hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Griffe, um die Tabs neu anzuordnen. Suche bleibt an der Systemposition. Einstellungen bleibt verfügbar, wenn die Mediathek ausgeblendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the handles to reorder tabs. Search keeps its native system position. Settings remains available when Library is hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los controles para reordenar las pestañas. Buscar conserva la posición del sistema. Ajustes permanece disponible si se oculta Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les poignées pour réorganiser les onglets. Recherche conserve sa place native. Réglages reste disponible si Bibliothèque est masquée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте маркеры, чтобы изменить порядок вкладок. Поиск остаётся на системном месте. Настройки доступны, даже если медиатека скрыта."
          }
        }
      }
    },
